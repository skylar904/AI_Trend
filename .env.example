OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-nano
MAX_DAILY_ARTICLES=30
MAX_ENTRIES_PER_SOURCE=10
MIN_RELEVANCE_SCORE=60

# Database
# Use sqlite for local file storage, or mysql for MySQL/Oracle VM deployment.
DB_TYPE=sqlite
SQLITE_DB_NAME=articles.db

# MySQL example:
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=000000
# DB_NAME=ai_trend

# Production database (Oracle host)
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_trend
DB_USER=ai_trend
DB_PASSWORD=replace_with_a_strong_password

# Local SQLite alternative. Used only when DB_TYPE=sqlite.
SQLITE_DB_NAME=articles.db

# Article analysis and daily topic ranking
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
TOPIC_MODEL=gpt-5.4-nano

# Project Advisor. The model is currently fixed in project_advisor.py as
# gemini-3.1-flash-lite, so GEMINI_MODEL is intentionally not configured here.
GEMINI_API_KEY=
GEMINI_TIMEOUT=45

# Optional source credentials. Sources that require a missing credential are
# skipped; sources without credentials continue to run.
GITHUB_TOKEN=
HF_TOKEN=
PRODUCT_HUNT_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SEMANTIC_SCHOLAR_API_KEY=

# Collection limits
# MAX_DAILY_ARTICLES is the accepted-article cap for one crawler run, not an
# OpenAI request cap and not a whole-calendar-day cap. Use 0 for no global cap.
MAX_DAILY_ARTICLES=30
MAX_ENTRIES_PER_SOURCE=30
MIN_RELEVANCE_SCORE=60

# Daily topic generation
TOPIC_BATCH_SIZE=120
BATCH_TOPIC_CANDIDATES=10
FINAL_TOPIC_LIMIT=5
DISPLAY_EVIDENCE_ARTICLES=10
MAX_TOPIC_SUMMARY_CHARS=520
